# Streamlit Secrets 예시 파일.
#
# 로컬에서 secrets로 테스트하고 싶다면:
#   1. 이 파일을 같은 폴더의 `secrets.toml` 로 복사
#   2. OPENAI_API_KEY 값을 실제 키로 교체
#   3. `secrets.toml` 은 .gitignore 되어 있으므로 절대 커밋 금지
#
# Streamlit Community Cloud에 배포할 때는 이 파일을 만들지 말고,
# 대시보드의 [Settings → Secrets] 화면에 아래 같은 내용을 붙여넣으세요.

OPENAI_API_KEY = "sk-여기에-당신의-키를-붙여넣으세요"
